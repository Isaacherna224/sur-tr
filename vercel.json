{
  "buildCommand": "pnpm install && pnpm run build",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.gestoriasyverificacionesdelsur.com" }],
      "destination": "https://gestoriasyverificacionesdelsur.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/placas-morelos",
      "destination": "/placas-morelos/index.html"
    },
    {
      "source": "/refrendo-morelos",
      "destination": "/refrendo-morelos/index.html"
    },
    {
      "source": "/verificacion-morelos",
      "destination": "/verificacion-morelos/index.html"
    },
    {
      "source": "/tenencia-morelos",
      "destination": "/tenencia-morelos/index.html"
    },
    {
      "source": "/((?!api/|sitemap.xml|robots.txt|_next/|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}